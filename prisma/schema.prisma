generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Runtime connection. On Vercel this MUST be the Supabase Supavisor
  // pooler (aws-<n>-<region>.pooler.supabase.com:6543) with
  // ?pgbouncer=true&connection_limit=1.
  //
  // The direct host, db.<ref>.supabase.co, publishes only an AAAA record
  // — it is IPv6-only — and Vercel's serverless functions have no
  // outbound IPv6, so every query there fails with P1001 in production
  // while working fine from a developer machine. The pooler is IPv4 and
  // also bounds connections, which a serverless runtime needs anyway.
  url = env("DATABASE_URL")

  // Migrations and `db push` need a session-mode connection, because
  // transaction-mode pooling cannot run DDL. Point this at the direct
  // host or at the pooler on port 5432.
  directUrl = env("DIRECT_URL")
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  passwordHash      String
  emailVerified     DateTime?
  verificationToken String?
  verificationTokenExpiry DateTime?
  resetToken        String?
  resetTokenExpiry  DateTime?
  image             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions        Session[]
  watchlists      Watchlist[]
  researchHistory ResearchHistory[]
  savedResearch   SavedResearch[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model Watchlist {
  id        String          @id @default(cuid())
  name      String          @default("Default")
  userId    String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id          String   @id @default(cuid())
  watchlistId String
  symbol      String
  name        String
  addedAt     DateTime @default(now())
  watchlist   Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, symbol])
  @@index([watchlistId])
  @@map("watchlist_items")
}

model ResearchHistory {
  id       String   @id @default(cuid())
  userId   String
  symbol   String
  name     String
  viewedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, viewedAt])
  @@map("research_history")
}

model SavedResearch {
  id        String   @id @default(cuid())
  userId    String
  symbol    String
  name      String
  data      Json
  notes     String?
  savedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_research")
}
