# ============================================================
# BlockLens environment
#
# Every key here is read on the server only, except
# NEXT_PUBLIC_APP_URL. None of the secrets may be prefixed
# NEXT_PUBLIC_ — that would inline the value into the client bundle.
# ============================================================

# --- Required ------------------------------------------------

# Runtime database connection. On Vercel this MUST be the Supabase
# Supavisor POOLER, not the direct host:
#
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# The direct host, db.<ref>.supabase.co, publishes only an AAAA (IPv6)
# record. Vercel functions have no outbound IPv6, so every query fails
# there with P1001 and login returns "An unexpected error occurred",
# while the same string works from a developer machine. This was the
# production login failure. `npm run verify:auth` checks for it.
DATABASE_URL=postgresql://user:password@localhost:5432/blocklens

# Session-mode connection used only by `prisma generate`, `db push` and
# migrations (transaction pooling cannot run DDL). The direct host is
# fine here. Vercel does not expand ${VAR}: set a literal string.
DIRECT_URL=postgresql://user:password@localhost:5432/blocklens

# JWT signing key, 32+ characters: openssl rand -base64 32
AUTH_SECRET=

# Public origin, no trailing slash. In production the https:// origin —
# emailed links are built from it.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# --- Email (Resend) ------------------------------------------
# Verification, password reset and alert emails.
# Without a key: development logs emails to the console; production
# refuses to pretend and reports delivery as failed.
RESEND_API_KEY=
# The sender's domain must be verified at https://resend.com/domains.
# Until one is, "BlockLens <onboarding@resend.dev>" works but only
# delivers to the Resend account owner's own address.
# (EMAIL_FROM is still read as a fallback for older environments.)
RESEND_FROM_EMAIL="BlockLens <onboarding@resend.dev>"


# --- AI (Google Gemini) --------------------------------------
# Research interpretation and portfolio insights. Server-side only.
# Without a key both features report themselves unavailable.
GEMINI_API_KEY=
# Model id. Default and recommended: gemini-3.5-flash-lite (stable,
# lowest-cost tier with JSON-schema output). Change here, not in code.
GEMINI_MODEL=gemini-3.5-flash-lite


# --- Chain data + token prices (Alchemy) ---------------------
# Wallet import (Ethereum, Base, Arbitrum, Optimism, Polygon, Solana),
# token prices by contract, historical prices older than 365 days, and
# the research page's chain metrics. Without it wallet import is off.
ALCHEMY_API_KEY=


# --- Market data (CoinGecko) ---------------------------------
# Optional. Live on the public tier without a key; a demo (CG-…) or pro
# key raises the rate limit. History is limited to 365 days on demo.
MARKET_DATA_API_KEY=


# --- News (RSS + GNews) --------------------------------------
# Optional. RSS always works; a GNews key widens coverage.
NEWS_API_KEY=


# --- Scheduled jobs (Vercel Cron) ----------------------------
# Bearer secret for /api/cron/sync (daily wallet sync + alert checks,
# see vercel.json). Vercel sends it automatically once set. 16+ chars:
# openssl rand -base64 32. Without it the cron route refuses to run.
CRON_SECRET=


# --- Development ---------------------------------------------
# Serve built-in sample data instead of calling providers (offline work).
# Never used to cover for a failed live call.
# BLOCKLENS_SAMPLE_DATA=true
